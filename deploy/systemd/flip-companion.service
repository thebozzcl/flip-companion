[Unit]
Description=Flip Companion — bottom-screen panel for AYANEO Flip DS
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/flip-companion --lease-socket /tmp/gamescope-lease.sock  --ui-scale 2.0
Restart=on-failure
RestartSec=3
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=graphical-session.target

