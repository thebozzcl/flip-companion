// Global state singletons — Rust backend writes to these via
// app.global::<Store>().set_*() through upgrade_in_event_loop().
// UI components read from these directly.

export global StatsStore {
    in-out property <float> cpu-usage: 0;
    in-out property <float> cpu-temp: 0;
    in-out property <float> gpu-usage: 0;
    in-out property <float> gpu-temp: 0;
    in-out property <float> mem-used-gb: 0;
    in-out property <float> mem-total-gb: 16;
    in-out property <float> battery-percent: 0;
    in-out property <bool> battery-charging: false;
    in-out property <string> clock-text: "--:--";
    in-out property <[float]> cpu-history;
    in-out property <[float]> gpu-history;
    in-out property <[float]> mem-history;
}

// A single entry in the window list shown by the shuttle panel.
export struct WindowEntry {
    id: string,
    caption: string,
    output: string,
}

export global ShuttleStore {
    in-out property <[WindowEntry]> windows;
}

// A single launchable app entry for the Apps panel.
export struct AppEntryData {
    name: string,
    icon: string,
    exec: string,
    url: string,
}

export global AppStore {
    in-out property <[AppEntryData]> apps;
    in-out property <bool> is-running: false;
    in-out property <string> running-app-name: "";
    in-out property <float> ui-scale: 1.0;

    // Theme colors — set at startup from theme.toml
    in-out property <color> color-background:          #1a1a2e;
    in-out property <color> color-surface:             #16213e;
    in-out property <color> color-interactive:         #0f3460;
    in-out property <color> color-interactive-pressed: #1a5276;
    in-out property <color> color-text-primary:        #e0e0f0;
    in-out property <color> color-text-secondary:      #a0a0b8;
    in-out property <color> color-accent:              #e94560;
    in-out property <color> color-border:              #2a2a4a;
    in-out property <color> color-running-app:         #1a3a1a;
    in-out property <color> color-running-app-text:    #90ee90;
}
