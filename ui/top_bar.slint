// Top status bar — clock, game name, battery indicator.

import { StatsStore } from "globals.slint";
import { AppStore } from "globals.slint";

export component TopBar inherits Rectangle {
    height: (40px * AppStore.ui-scale);
    background: AppStore.color-surface;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: space-between;

        // Left: clock
        Text {
            text: StatsStore.clock-text;
            font-size: 18px * AppStore.ui-scale;
            color: AppStore.color-text-primary;
            vertical-alignment: center;
        }

        // Center: game name (hardcoded for now)
        Text {
            text: "Steam Game Mode";
            font-size: 16px * AppStore.ui-scale;
            color: AppStore.color-text-secondary;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // Right: battery
        Text {
            text: StatsStore.battery-charging
                ? "⚡ " + Math.round(StatsStore.battery-percent) + "%"
                : "🔋 " + Math.round(StatsStore.battery-percent) + "%";
            font-size: 16px * AppStore.ui-scale;
            color: StatsStore.battery-percent < 20 ? AppStore.color-accent : AppStore.color-text-primary;
            vertical-alignment: center;
        }
    }
}
